# Rendered by the nginx image entrypoint at startup (envsubst) into /etc/nginx/conf.d/default.conf.
# Only defined environment variables are substituted, so nginx variables like $uri stay as they are.
#   API_UPSTREAM                 where /api is proxied to (default in the Dockerfile: http://api:80)
#   NGINX_LOCAL_RESOLVERS        filled from /etc/resolv.conf because NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
    gzip_vary on;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Never cache the entry page: after a redeploy it must point to the new hashed assets.
    # The SPA fallback above also ends up here (internal redirect).
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
    }

    # API reverse proxy. The upstream is in a variable, so its name is resolved per request,
    # not at startup: nginx starts even when the API host does not exist (frontend deployed alone).
    location /api/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;            # no URI part: /api/cv is passed on unchanged
        proxy_ssl_server_name on;            # needed when API_UPSTREAM is https
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 8s;               # shorter than the frontend's 10 s fetch timeout
        error_page 502 503 504 = @api_down;
    }

    # API missing or down: a clean 503, which the frontend shows as "service temporarily unavailable".
    location @api_down {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 503 '{"error":"API unavailable"}';
    }

    # Real files only: never fall back to index.html for a missing PDF,
    # otherwise the "Download as PDF" link saves an HTML page named *.pdf.
    location ~* \.pdf$ {
        try_files $uri =404;
    }

    location /assets/ {
        expires 1y;
        # add_header in a location replaces the server-level headers, so repeat them here.
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
    }
}
